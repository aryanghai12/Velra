source: crates/velra/tests/settings_edit.rs
expression: text
---
{
  // keep my own hooks first
  "model": "opus",
  /* block comment */
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "echo wrote" }]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "post-tool-use"
            ],
            "timeout": 10
          }
        ]
      },
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "user-prompt-submit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "pre-tool-use"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "pre-tool-use"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "pre-tool-use"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "post-tool-use-failure"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "reduce"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "stop"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "reduce"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "pre-compact"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "post-compact"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<VELRA_BIN>",
            "args": [
              "hook",
              "session-end"
            ],
            "timeout": 1
          }
        ]
      }
    ],
  },
}
