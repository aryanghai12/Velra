/target
**/*.rs.bk
*.pdb

# insta pending snapshots
*.snap.new
*.pending-snap

# Benchmark output. The derived measurements are tracked -- they are what
# BENCHMARK_REPORT.md cites -- but the raw session captures are not: they run
# to megabytes per trial, they embed absolute paths from whichever machine
# produced them, and bench/run_full_benchmark.py regenerates them.
/bench/results/trials/*/stream.jsonl
/bench/results/trials/*/transcript.jsonl
/bench/results/trials/*/velra.db
/bench/results/trials/*/velra.db-wal
/bench/results/trials/*/velra.db-shm
/bench/results/trials/*/velra_home/
/bench/results/superseded/
/bench/results/post-tool-use-*.json
/bench/results/pre-tool-use-*.json
/bench/results/pre-compact.json
/bench/results/user-prompt-submit.json

# npm wrapper: ignore binaries dropped into bin/ for a vendored/offline build,
# but never the launcher source itself - it is the package's entry point.
/npm/**/bin/*
!/npm/velra/bin/velra.js
/npm/**/node_modules/
/npm/**/*.tgz

# Local databases. Velra's own state lives in ~/.velra, but a stray trial or a
# manual `VELRA_HOME=. velra enable` can drop one in the tree.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Background task captures and scratch output.
*.output
*.tmp
*.bak
/scratch/
/tmp/

# Logs, except the one debug capture the benchmark report cites as evidence.
*.log
!/bench/results/trials/*/velra_debug.log

# Credentials and key material. Nothing here is tracked and nothing should be:
# Velra's redaction treats these paths as sensitive at runtime too (§J2).
.env
.env.*
*.pem
*.key
id_rsa*

# Editor and OS noise
.vscode/
.idea/
.DS_Store
._*
Thumbs.db
desktop.ini
__pycache__/
